<UserControl x:Class="DeskBot.App.Features.Home.HomePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel>
            <Border Style="{StaticResource Card}" Background="{StaticResource GlassGradient}" Padding="16,12">
                <StackPanel>
                    <TextBlock x:Name="BigClock" FontSize="46" FontWeight="Light" Text="--:--" />
                    <TextBlock x:Name="BigDate" Style="{StaticResource Caption}" FontSize="12.5" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,10,0,0" Cursor="Hand" MouseLeftButtonUp="Next_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="10" Background="#1FFFB020" Margin="0,0,10,0">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE823;" Foreground="#FFB020" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Caption}" Text="Дараагийн reminder" />
                        <TextBlock x:Name="NextTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="NextTime" Style="{StaticResource Caption}" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <StackPanel Grid.Column="2">
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="54" Height="54">
                        <Rectangle RadiusX="11" RadiusY="11" Fill="#14FFFFFF" />
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8D6;" Foreground="{StaticResource TextMuted}" />
                        <Rectangle RadiusX="11" RadiusY="11">
                            <Rectangle.Fill>
                                <ImageBrush x:Name="ArtBrush" Stretch="UniformToFill" />
                            </Rectangle.Fill>
                        </Rectangle>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="11,0,6,0" VerticalAlignment="Center">
                        <TextBlock x:Name="SongTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="SongArtist" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button x:Name="PlayBtn" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE768;" Click="Play_Click" />
                </Grid>
            </Border>

            <UniformGrid Columns="3" Margin="0,10,0,0">
                <Border Style="{StaticResource Card}" Margin="0,0,5,0" Padding="10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="CPU" />
                        <TextBlock x:Name="CpuText" FontSize="20" FontWeight="SemiBold" Text="—" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="5,0" Padding="10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="RAM" />
                        <TextBlock x:Name="RamText" FontSize="20" FontWeight="SemiBold" Text="—" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="5,0,0,0" Padding="10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="Battery" />
                        <TextBlock x:Name="BatText" FontSize="20" FontWeight="SemiBold" Text="—" />
                    </StackPanel>
                </Border>
            </UniformGrid>
            <TextBlock x:Name="RamDetail" Style="{StaticResource Caption}" Margin="4,8,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
