<UserControl x:Class="DeskBot.App.Features.Music.MusicPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <!-- Session байгаа үед -->
        <Grid x:Name="PlayerView">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Width="168" Height="168" VerticalAlignment="Top">
                <Rectangle RadiusX="20" RadiusY="20" Fill="#14FFFFFF" />
                <TextBlock Style="{StaticResource Icon}" Text="&#xE8D6;" FontSize="40" Foreground="{StaticResource TextMuted}" />
                <Rectangle RadiusX="20" RadiusY="20">
                    <Rectangle.Fill>
                        <ImageBrush x:Name="ArtBrush" Stretch="UniformToFill" />
                    </Rectangle.Fill>
                </Rectangle>
            </Grid>

            <StackPanel Grid.Column="1" Margin="20,4,4,0">
                <TextBlock x:Name="SourceText" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ArtistText" Style="{StaticResource Caption}" FontSize="13" Margin="0,2,0,16" TextTrimming="CharacterEllipsis" />

                <Slider x:Name="Progress" Minimum="0" Maximum="1" />
                <Grid Margin="0,0,0,10">
                    <TextBlock x:Name="PosText" Style="{StaticResource Caption}" Text="0:00" />
                    <TextBlock x:Name="DurText" Style="{StaticResource Caption}" HorizontalAlignment="Right" Text="0:00" />
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="PrevBtn" Style="{StaticResource IconButton}" Width="42" Height="42" FontSize="16" Content="&#xE892;" Click="Prev_Click" />
                    <Button x:Name="PlayBtn" Style="{StaticResource IconButton}" Width="52" Height="52" FontSize="22" Background="#2633E1FF" Content="&#xE768;" Click="Play_Click" Margin="10,0" />
                    <Button x:Name="NextBtn" Style="{StaticResource IconButton}" Width="42" Height="42" FontSize="16" Content="&#xE893;" Click="Next_Click" />
                </StackPanel>
                <TextBlock x:Name="LimitText" Style="{StaticResource Caption}" Margin="0,12,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <!-- Session байхгүй үед — хуурамч дуу харуулахгүй -->
        <StackPanel x:Name="EmptyView" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE8D6;" FontSize="34" Foreground="{StaticResource TextMuted}" />
            <TextBlock x:Name="EmptyTitle" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4" Text="Media session алга" />
            <TextBlock x:Name="EmptyHint" Style="{StaticResource Caption}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="380" TextWrapping="Wrap"
                       Text="Spotify, YouTube (Chrome/Edge) эсвэл Windows media control-д бүртгэлтэй app-аас дуу тоглуулахад энд автоматаар гарч ирнэ." />
        </StackPanel>
    </Grid>
</UserControl>
