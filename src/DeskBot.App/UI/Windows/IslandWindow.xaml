<Window x:Class="DeskBot.App.UI.Windows.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DeskBot.App.UI.Controls"
        Title="DeskBot"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Width="260" Height="60"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!-- Island-ээс гаднах хэсэг бүрэн тунгалаг → mouse click доорх app руу дамжина -->
    <Grid x:Name="Root">
        <Border x:Name="Island"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Width="190" Height="34"
                CornerRadius="0,0,18,18"
                Background="#F5050608"
                BorderBrush="#2433E1FF"
                BorderThickness="1,0,1,1"
                SnapsToDevicePixels="True">
            <Border.RenderTransform>
                <TranslateTransform x:Name="IslandShift" />
            </Border.RenderTransform>

            <Grid x:Name="IslandGrid" ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ── Header: face + contextual info ── -->
                <Grid x:Name="Header" Height="34" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Collapsed үеийн жижиг status indicator-ууд -->
                    <Ellipse x:Name="ReminderDot" Width="6" Height="6" Fill="#FFB020"
                             HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed" />
                    <TextBlock x:Name="MusicGlyph" Grid.Column="2" Style="{StaticResource Icon}" Text="&#xE8D6;" FontSize="11"
                               Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Left" Margin="8,0,0,0" Visibility="Collapsed" />

                    <!-- Hover/expanded үеийн мэдээлэл -->
                    <StackPanel x:Name="LeftInfo" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,8,0" Opacity="0" IsHitTestVisible="False">
                        <TextBlock x:Name="ClockText" FontSize="13" FontWeight="SemiBold" Text="--:--" />
                        <TextBlock x:Name="DateText" Style="{StaticResource Caption}" Margin="8,1,0,0" VerticalAlignment="Center" Text="" />
                    </StackPanel>

                    <controls:RobotFace x:Name="Face" Grid.Column="1" Width="112" Margin="0,1" />

                    <Grid Grid.Column="2" Margin="8,0,10,0">
                        <!-- Hover: now playing mini -->
                        <StackPanel x:Name="RightInfo" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False">
                            <Border x:Name="MiniArtBorder" Width="20" Height="20" CornerRadius="5" Margin="0,0,7,0" Background="#1AFFFFFF" ClipToBounds="True">
                                <Image x:Name="MiniArt" Stretch="UniformToFill" />
                            </Border>
                            <TextBlock x:Name="MiniTitle" MaxWidth="96" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="11.5" />
                            <Button x:Name="MiniPlay" Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="12" Content="&#xE768;" Click="MiniPlay_Click" />
                        </StackPanel>
                        <!-- Expanded: actions -->
                        <StackPanel x:Name="ExpandedActions" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed">
                            <Button x:Name="PinButton" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="12" Content="&#xE718;" ToolTip="Pin (нээлттэй үлдээх)" Click="PinButton_Click" />
                            <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="11" Content="&#xE711;" ToolTip="Хаах (Esc)" Click="CloseButton_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ── Reminder alert bar ── -->
                <Grid x:Name="AlertBar" Grid.Row="1" Margin="16,2,12,10" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE823;" Foreground="#FFB020" Margin="0,0,10,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AlertTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="AlertTime" Style="{StaticResource Caption}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource PillButton}" Margin="0,0,6,0" Content="Snooze 5м" Click="AlertSnooze_Click" />
                        <Button Style="{StaticResource AccentButton}" Margin="0" Content="Done" Click="AlertDone_Click" />
                    </StackPanel>
                </Grid>

                <!-- ── Expanded control center ── -->
                <ContentControl x:Name="PanelHost" Grid.Row="1" Visibility="Collapsed" Opacity="0" Focusable="False" />
            </Grid>
        </Border>
    </Grid>
</Window>
